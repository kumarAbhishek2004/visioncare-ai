# ==============================================================================
# VisionCare AI — Git Ignore
# ==============================================================================

# Explicitly excluded by user
visioncare_kaggle_training.py
kaggle/visioncare_kaggle_training.py
tests/

# Large Model Weights & Checkpoints (Store on Hugging Face / S3 / Git LFS)
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.onnx
*.h5
*.weights
*.pkl
*.pickle
pretrained/*.pth
pretrained/*.pt

# Allow JSON calibration parameters and validation metrics in pretrained/
!pretrained/*.json

# Medical Imaging Data & Raw Archives
datasets/
data/
*.dcm
*.dicom
*.tar.gz
*.tar
*.gz
*.zip
*.7z
*.rar
*.csv

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environments & Sensitive Credentials
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
venv/
.venv/
env/
ENV/

# Frontend Build & Node Modules
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/build/
build/
dist/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & IDE Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary & Output Files
*.log
*.tmp
*.pdf
!docs/*.pdf

# Docker Configuration Files (Excluded per user request)
Dockerfile*
docker-compose*.yml
.dockerignore
