# ==============================================================================
# VisionCare AI — Git Ignore
# ==============================================================================

# Explicitly excluded by user
visioncare_kaggle_training.py
kaggle/visioncare_kaggle_training.py
tests/

# Large Model Weights & Checkpoints (Store on Hugging Face / S3 / Git LFS)
*.pth
*.pt
*.bin
*.onnx
*.h5
*.weights
pretrained/*.pth

# Allow JSON metadata and configs in pretrained/
!pretrained/*.json

# Medical Imaging Data & Raw Archives
datasets/NIH/
*.dcm
*.tar.gz
*.zip

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Environments & Dependencies
.env
.env.local
.env.*.local
venv/
.venv/
env/

# Frontend Build & Node Modules
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Temporary & Log Files
*.log
reports/*.pdf
