# ==============================================================================
# VisionCare AI — Environment Configuration Template
# Copy this file to .env and insert your API keys:
# cp .env.example .env
# ==============================================================================

# 1. Groq API Key (Recommended - Free & Ultra-Fast at https://console.groq.com/)
GROQ_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# 2. Google Gemini API Key (Optional fallback at https://aistudio.google.com/)
GEMINI_API_KEY=

# 3. Optional: OpenAI direct API Key
OPENAI_API_KEY=

