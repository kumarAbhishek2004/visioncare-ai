# ==============================================================================
# VisionCare AI — Environment Configuration
# ==============================================================================

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI / Open-Source (OSS) LLM API Key (https://platform.openai.com/ or OSS proxy)
OPENAI_API_KEY=

# Target Model: GPT OSS 120B / GPT-4o
OPENAI_MODEL=gpt-oss-120b

# (Optional) Base URL if using OpenRouter, Groq, Together, Ollama, or vLLM:
# For OpenRouter (supports GPT OSS models): https://openrouter.ai/api/v1
# For Together AI: https://api.together.xyz/v1
# For Groq: https://api.groq.com/openai/v1
# For Local Ollama: http://localhost:11434/v1
# For Local vLLM: http://localhost:8000/v1
# OPENAI_BASE_URL=
